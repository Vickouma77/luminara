# Environment variables for local development
# Copy this file to .env and modify as needed

# =============================================================================
# Application Environment
# =============================================================================
APP_ENV=development
# Options: development, staging, production

# =============================================================================
# Database Configuration (shared-database library)
# =============================================================================
DATABASE_URL=postgresql://luminara:luminara_dev@localhost:5432/luminara

# Database Pool Settings (optional - defaults based on APP_ENV)
DB_MAX_CONNECTIONS=5
DB_MIN_CONNECTIONS=1
DB_CONNECT_TIMEOUT_SECS=30
DB_IDLE_TIMEOUT_SECS=300
DB_MAX_LIFETIME_SECS=1800
DB_SSL_MODE=disable
# SSL Options: disable (dev), prefer (staging), require (production)

# Auth Service
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=8001
AUTH_DATABASE_URL=postgresql://luminara:luminara_dev@localhost:5432/auth_service

# User Service
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=8002
USER_DATABASE_URL=postgresql://luminara:luminara_dev@localhost:5432/user_service

# Account Service
ACCOUNT_SERVICE_HOST=0.0.0.0
ACCOUNT_SERVICE_PORT=8003
ACCOUNT_DATABASE_URL=postgresql://luminara:luminara_dev@localhost:5432/account_service

# Transaction Service
TRANSACTION_SERVICE_HOST=0.0.0.0
TRANSACTION_SERVICE_PORT=8004
TRANSACTION_DATABASE_URL=postgresql://luminara:luminara_dev@localhost:5432/transaction_service

# KYC Service
KYC_SERVICE_HOST=0.0.0.0
KYC_SERVICE_PORT=8005
KYC_DATABASE_URL=postgresql://luminara:luminara_dev@localhost:5432/kyc_service

# Notification Service
NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=8006
NOTIFICATION_DATABASE_URL=postgresql://luminara:luminara_dev@localhost:5432/notification_service

# Payment Service
PAYMENT_SERVICE_HOST=0.0.0.0
PAYMENT_SERVICE_PORT=8007
PAYMENT_DATABASE_URL=postgresql://luminara:luminara_dev@localhost:5432/payment_service

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=3600

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Jaeger
JAEGER_AGENT_ENDPOINT=localhost:6831
