@startuml Account Creation Flow
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceParticipant underline

actor "User" as U
participant "User Service" as US
participant "Account Service" as ACCS
participant "Event Bus" as EB
participant "Core Banking" as CB
participant "Card Service" as CS
participant "Notification Service" as NS
database "User DB" as UDB

title Account Creation Flow (Post-KYC Approval)

U -> US: Request account opening
activate US
US -> UDB: Check user KYC status
UDB --> US: KYC_APPROVED status

alt KYC not approved
    US --> U: 403 Forbidden - Complete KYC first
else KYC approved
    US -> EB: Publish AccountCreationRequested Event
    activate EB

    EB -> ACCS: Create new account
    activate ACCS

    ACCS -> CB: Open account in core system
    activate CB
    CB --> ACCS: Account details (account number, etc.)
    deactivate CB

    ACCS -> EB: Publish AccountCreated Event

    EB -> US: Link account to user
    US -> UDB: Update user with account reference
    US --> EB: UserAccountLinked Event

    EB -> CS: Issue debit card
    activate CS
    CS --> EB: CardIssuanceInitiated Event
    deactivate CS

    EB -> NS: Send account creation notification
    activate NS
    NS --> EB: AccountCreationNotified Event
    deactivate NS

    ACCS --> US: Account creation successful
    deactivate ACCS
    US --> U: Account created successfully
    deactivate EB
end
deactivate US

@enduml